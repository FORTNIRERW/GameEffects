
import random
import raylib as rl
from pyray import *

posx = 100
posy = 100


# all we need to do is rotate an object
#the intensity is based on how much rotation is being done-- the increment
# the length of the rotation will be the time
# and the number will tell us how many times we do this


# increase a number when it gets to length
# then we decrease the number when it gets to -length
# then we add 1 to the times
# and loop until times == times
class Shake:
    def __init__(self,intensity_min,intensity_max,length_min,length_max,times,currentvalue):
        self.intensity_min = intensity_min
        self.intensity_max = intensity_max
        self.length_min = length_min
        self.length_max = length_max
        self.times = times
        self.currentvalue = currentvalue
        self.original_length = 0
        self.original_value = currentvalue
    def Randomize(self):
        self.intensity = random.uniform(self.intensity_min,self.intensity_max)
        self.length = random.uniform(self.length_min,self.length_max)
        self.original_length = 0
        self.shake = True

    def NotRandom(self):
        self.intensity = self.intensity_max
        self.length = self.length_max
        self.original_length = 0
        self.shake = True

    def shake_ya_booty(self):
        if self.shake == True:
            self.currentvalue += self.intensity
            self.original_length += self.intensity
            if abs(self.original_length) >= abs(self.length):
                self.intensity = -self.intensity
                self.times -=1
                if self.times <= 0:
                    self.currentvalue = self.original_value
                    self.shake = False
            

        

